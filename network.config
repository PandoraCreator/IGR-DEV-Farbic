# default image tag, example: "2.5.13".  "default" will download the latest. (-i)
IMAGETAG="default"

# default ca image tag, example: "1.5.15". "default" will download the latest. (-cai)
CA_IMAGETAG="default"

# Using crpto vs CA. default is cryptogen
CRYPTO="cryptogen"

# max number of retries before giving up (-r)
MAX_RETRY=5

# default for delay between commands (-d)
CLI_DELAY=3

# channel name defaults to "igrchannel" (-c)
CHANNEL_NAME="igrchannel"

# default database (-s)
DATABASE="leveldb"

# default org (-org)
ORG=1

# chaincode language defaults to "NA" (-ccl)
CC_SRC_LANGUAGE="go"

# Chaincode version (-ccv)
CC_VERSION="1.0"

# UAT chaincode name (-ccn). Live POC on servers may still use asset_registry until MA-04.
CC_NAME="igr_anchor"

# default to running the docker commands for the CCAAS (-ccaasdocker)
CCAAS_DOCKER_RUN=true

# chaincode path defaults to "NA" (-ccp) — sibling ../chaincode at repo root
CC_SRC_PATH="../chaincode"

# endorsement policy defaults to "NA". This would allow chaincodes to use the majority default policy. (-ccep)
CC_END_POLICY="NA"

# collection configuration defaults to "NA" (-cccg)
CC_COLL_CONFIG="NA"

# chaincode init function defaults to "NA" (-cci)
CC_INIT_FCN="NA"

# Chaincode definition sequence, this should be an integer or auto (-ccs)
CC_SEQUENCE=auto

# Default constructor for testing a chaincode invoke (-ccic)
CC_INVOKE_CONSTRUCTOR=''{\"function\":\"CreateAnchorVersion\",\"Args\":[\"MH:PUNE:SR42:2026:991:V1\",\"MH:PUNE:SR42:2026:991\",\"sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\"REF-001\",\"\"]}''

# Default constructor for testing a chaincode query (-cciq)
CC_QUERY_CONSTRUCTOR=''{\"function\":\"GetLatestAnchor\",\"Args\":[\"MH:PUNE:SR42:2026:991\"]}''

